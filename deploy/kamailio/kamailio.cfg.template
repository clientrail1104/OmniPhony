#!KAMAILIO
# Reference ingress/registrar. REQUIRED: provision subscriber/location tables with
# matching upstream kamdbctl schema. Tenant domains need domain table entries.
# WSS terminates at a private trusted TLS reverse proxy on THIS host -> port 8080.
debug=2
log_stderror=yes
fork=yes
children=8
enable_tcp=yes
tcp_connection_lifetime=3605
tcp_accept_no_cl=yes
listen=udp:__PRIVATE_IP__:5060 advertise __PUBLIC_IP__:5060
listen=tcp:127.0.0.1:8080
alias=voice.example.org
loadmodule "db_postgres.so"
loadmodule "sl.so"
loadmodule "tm.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "sanity.so"
loadmodule "xlog.so"
loadmodule "auth.so"
loadmodule "auth_db.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "dispatcher.so"
loadmodule "nathelper.so"
loadmodule "xhttp.so"
loadmodule "websocket.so"
loadmodule "domain.so"
modparam("auth_db", "db_url", "__KAMAILIO_DB_URL__")
modparam("auth_db", "calculate_ha1", 0)
modparam("auth_db", "password_column", "ha1")
modparam("auth_db", "use_domain", 1)
modparam("usrloc", "db_url", "__KAMAILIO_DB_URL__")
modparam("usrloc", "db_mode", 3)
modparam("usrloc", "use_domain", 1)
modparam("domain", "db_url", "__KAMAILIO_DB_URL__")
modparam("registrar", "received_avp", "$avp(RECEIVED)")
modparam("nathelper", "received_avp", "$avp(RECEIVED)")
modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
modparam("dispatcher", "ds_ping_interval", 5)
modparam("dispatcher", "ds_probing_mode", 1)
modparam("dispatcher", "ds_ping_method", "OPTIONS")
modparam("rr", "enable_full_lr", 1)
request_route {
 if (!mf_process_maxfwd_header("12")) { sl_send_reply("483","Too Many Hops"); exit; }
 if (!sanity_check("1511","7")) { exit; }
 force_rport();
 if (is_method("CANCEL")) { if(t_check_trans()) t_relay(); exit; }
 if (has_totag()) {
   if (loose_route()) { if (!t_relay()) sl_reply_error(); exit; }
   if (is_method("ACK") && t_check_trans()) { t_relay(); exit; }
   sl_send_reply("404","No dialog route"); exit;
 }
 if (is_method("OPTIONS") && uri==myself) { sl_send_reply("200","OK"); exit; }
 if (is_method("REGISTER")) {
   if (!is_from_local()) { sl_send_reply("403","Unknown realm"); exit; }
   if (!auth_check("$fd", "subscriber", "1")) { auth_challenge("$fd","0"); exit; }
   if ($tU != $au || $td != $fd) { sl_send_reply("403","Identity mismatch"); exit; }
   fix_nated_register();
   if (!save("location")) sl_reply_error();
   exit;
 }
 # Requests from media nodes are routed to registered agents. Trust IP only inside
 # private firewall/VPN. Carrier trunks terminate on authenticated media profiles.
 if (ds_is_from_list()) {
   if (!lookup("location")) { sl_send_reply("480","Agent unavailable"); exit; }
   record_route();if (!t_relay()) sl_reply_error();exit;
 }
 if (!is_method("INVITE")) { sl_send_reply("405","Method not allowed"); exit; }
 if (!is_from_local()) { sl_send_reply("403","Unknown realm"); exit; }
 if (!auth_check("$fd", "subscriber", "1")) { auth_challenge("$fd","0"); exit; }
 consume_credentials();
 # Strip caller-supplied trust headers. A trusted control adapter must derive tenant
 # and permitted destination from authenticated realm; NEVER accept user billing IDs.
 remove_hf("X-Tenant-ID");remove_hf("X-Account-ID");
 record_route();
 if (!ds_select_dst("1","4")) { sl_send_reply("503","No media capacity"); exit; }
 if (!t_relay()) sl_reply_error();
}
event_route[xhttp:request] {
 if ($si != "127.0.0.1") { xhttp_reply("403","Forbidden","text/plain","Local proxy only"); exit; }
 if ($hdr(Origin) != "https://workspace.example.org") { xhttp_reply("403","Forbidden","text/plain","Origin denied"); exit; }
 if ($hdr(Upgrade) =~ "websocket" && $hdr(Sec-WebSocket-Protocol) =~ "sip") {
   if (ws_handle_handshake()) exit;
 }
 xhttp_reply("400","Bad Request","text/plain","WebSocket required");
}
