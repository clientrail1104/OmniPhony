<include>
 <context name="contact-center">
  <extension name="provisioning-gate">
   <condition field="destination_number" expression="^(.+)$">
    <!-- Fail closed until the authenticated tenant-aware control adapter is deployed.
    Replace with authorized Lua/XML-CURL routing described in ARCHITECTURE.md.
    This prevents a reference deployment becoming an unbilled open PSTN relay. -->
    <action application="hangup" data="CALL_REJECTED"/>
   </condition>
  </extension>
 </context>
</include>
